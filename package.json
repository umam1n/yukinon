{
  "name": "yukinon",
  "version": "0.1.0",
  "description": "Hybrid audiophile music player — local FLAC + YouTube Music with a 10-band EQ",
  "main": "out/main/index.js",
  "author": "umam1n",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=4096\" electron-vite dev",
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096\" electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "@supabase/supabase-js": "^2.46.1",
    "better-sqlite3": "^11.5.0",
    "cross-fetch": "^4.0.0",
    "howler": "^2.2.4",
    "music-metadata": "^10.5.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/howler": "^2.2.11",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.umam1n.yukinon",
    "productName": "YUKINON",
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ]
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
